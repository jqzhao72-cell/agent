# ===========================================
# Deep Search Pro - 环境变量配置模板
# 复制此文件为 .env，并且只在 .env 中填写真实密钥。
# ===========================================

# ---------- 知识库服务 ----------
KNOWLEDGE_BACKEND=docpilot
DOCPILOT_BASE_URL=http://127.0.0.1:8000
DOCPILOT_USERNAME=your-docpilot-username
DOCPILOT_PASSWORD=your-docpilot-password
DOCPILOT_ACCESS_TOKEN=

RAGFLOW_API_URL=http://your-ragflow-server-ip
RAGFLOW_API_KEY=your-ragflow-api-key

# ---------- DeepSeek 官网：主模型 + 子 Agent ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
LLM_MAIN_MODEL=deepseek-v4-pro
SUBAGENT_MODEL=deepseek-flash
LLM_ENABLE_THINKING=false

# ---------- 阿里云百炼：Qwen 内置联网搜索 ----------
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-bailian-api-key
ALIYUN_SEARCH_MODEL=qwen-flash
ALIYUN_SEARCH_STRATEGY=turbo

# ---------- Agent 运行限制 ----------
AGENT_RECURSION_LIMIT=40
CHECKPOINT_DB_PATH=data/checkpoints.db

# ---------- 三层记忆 ----------
MEMORY_DB_PATH=data/memory.db
MEMORY_RECENT_TURNS=8
MEMORY_SUMMARY_MAX_CHARS=800
MEMORY_LONG_TERM_MAX_ITEMS=5

# ---------- MySQL 数据库（可选） ----------
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=your-database-name
MYSQL_HOST=localhost
MYSQL_PORT=3306
